# Copy this file to .env.local and fill in your own keys.
# NEVER commit .env.local — it is already in .gitignore.

# ---- Primary LLM: Groq (free, no credit card) ----
# https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ---- Fallback LLM #1: Google Gemini (free tier, no credit card) ----
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Fallback LLM #2: OpenRouter (free ":free" models, no credit card) ----
# https://openrouter.ai/keys — pick any model tagged "free" from
# https://openrouter.ai/models and put its id below.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Supabase Postgres (free tier) ----
# https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- Admin Auth ----
ADMIN_JWT_SECRET=change-this-to-a-long-random-string

# ---- Optional ----
NEXT_PUBLIC_SITE_URL=https://interview.internadda.com
